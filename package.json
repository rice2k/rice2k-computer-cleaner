{
  "name": "rice2k-computer-cleaner",
  "version": "1.0.0",
  "description": "Rice2k Computer Cleaner is a Windows desktop PC care app with safe scans, cache cleanup, startup review, update review, driver age review, and duplicate finding.",
  "main": "src/main.js",
  "author": "rice2k",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "npx --yes electron-builder@26.15.3 --dir",
    "portable": "npx --yes electron-builder@26.15.3 --win portable --publish=never",
    "dist": "npx --yes electron-builder@26.15.3 --win nsis portable --publish=never",
    "screenshots": "electron scripts/capture-screenshots.js",
    "lint": "node scripts/smoke-test.js"
  },
  "build": {
    "appId": "com.rice2k.computercleaner",
    "productName": "Rice2k Computer Cleaner",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "renderer/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/rice2k-cleaner-icon.ico",
      "artifactName": "Rice2k-Computer-Cleaner-${version}-${arch}.${ext}",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^31.7.7"
  }
}
